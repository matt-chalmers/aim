# harness.yaml — the one file a project writes to make this harness its own.
#
# Copy to your repository ROOT (not into the plugin), then work through it with
# `/harness-setup`, which reads what it can from your repo and asks you only about
# the gaps.
#
# The values below are a NEUTRAL EXAMPLE for an imaginary two-part service. They are
# illustrative, not defaults — every one of them is a fact about a project, and a
# fact copied unread is worse than a blank.

name: Acme Widgets            # display name
slug: acme                    # lowercase, no hyphens — names per-worker resources

# The plugin version this file was last reviewed against. /harness-setup writes it —
# read from the plugin's own manifest, never typed — and the config check compares it
# with the installed plugin. When the plugin is newer, the campaign and swarm pre-flights
# stop until /harness-setup has applied the upgrade notes (docs/upgrading.md) and
# re-stamped. Leave it out and every pre-flight treats the config as unreviewed.
harness:
  version: 0.9.2

# Toolchains: how to RUN things. See harness/stacks/ for shipped modules, and add
# your own under .harness/stacks/ to shadow or extend them.
#
# A bare name means the toolchain lives at the repository root, which is the common
# case and needs no ceremony. Give a `root` when it lives in a subdirectory — the
# shipped modules name no location, because where a toolchain lives is a fact about
# YOUR project rather than about the toolchain.
stacks:
  - python-uv                        # root layout: pyproject.toml + uv.lock at the top
  - {name: node-npm, root: web}      # or relocated, with everything else following

  # A stack may also override its COMMANDS. The module ships a sensible default —
  # but `pytest` is a choice this project made, not a property of `uv`, so the
  # project is where a different one belongs. Overrides MERGE: naming one key
  # leaves the module's other commands intact.
  #
  # You rarely write these by hand. `harness/checks/check-stack-commands.sh
  # --repair` runs at pre-flight, and when a declared command has rotted it
  # derives a replacement from what this repository already declares (a CI line,
  # an npm script, a Make target), proves it by running it, and records it here
  # stamped `auto-repaired`. Read those in your next `git diff`.
  #
  # - name: python-uv
  #   commands:
  #     test_scoped: uv run pytest {path}   # auto-repaired 2026-09-05

# Frameworks: how to WRITE good code here. Independent of the toolchain — one
# toolchain serves many frameworks. See harness/frameworks/.
frameworks:
  - django
  - nextjs

# ---------------------------------------------------------------------------
# The task tracker. OMIT THIS BLOCK ENTIRELY to keep today's behaviour — `beads`, which
# is what every project used before the backend became swappable.
#
# The harness talks to the tracker through four ports, and only one of them is
# per-backend. Claiming a task and holding the merge slot coordinate THIS MACHINE's
# worker processes, and telemetry is an append-only series — none of that depends on
# where the records live, so all three have one implementation whatever you choose here.
# ---------------------------------------------------------------------------
tracker:
  backend: tasks              # tasks | mdfiles

  # --- mdfiles only ---------------------------------------------------------
  # Markdown records instead of a database. The one thing it buys: the tracked artefact
  # is per-task markdown, so a wave's tracker changes produce a REVIEWABLE DIFF, where
  # tasks' issues.jsonl is a blob that diffs badly.
  #
  # dir      the GITIGNORED hot store, reached by absolute path into the primary
  #          checkout — exactly as BEADS_DB is. Workers write here during a wave, so the
  #          checkout stays clean and their writes are not swept into a sibling's commit.
  # export   the TRACKED copy, regenerated by the ORCHESTRATOR once per wave. Required
  #          when backend is mdfiles: the hot store is gitignored, so without this the
  #          backlog lives only on the machine that ran the wave.
  #
  # dir: .harness/tasks
  # export: docs/tasks

  # A record size past which the backend fails. beads refuses at roughly 64KB and does so
  # CLOSED and SILENTLY — a 38-character append fails exactly as a 3KB one does. Declared
  # rather than hardcoded so `check-record-size.sh` warns about the real limit, and reports
  # that there is nothing to warn about on a backend with none.
  limits:
    record_bytes: 64000       # null on mdfiles: a file per record has no ceiling

beads:
  prefix: ACME                # what your issue ids start with; read it off `bd list`

swarm:
  merge_slot: ACME-merge-slot
  # A second name for a variable some prompt or doc still reads. Declared rather than
  # duplicated, so it cannot drift from its source.
  aliases: {}

# Every TCP port your servers bind, by name. The campaign owns these — workers are
# banned from binding them — and the pre-flight probes each one so a dev server left
# over from a killed run is caught before a wave, not one failed worker at a time.
# Declared here because they are a project fact: nothing scrapes them from prose.
# `ports: {}` if nothing listens — an answer, where omitting it earns a warning.
ports:
  frontend: 3000
  backend: 8000

# ---------------------------------------------------------------------------
# Where things live. Prose in the commands and skills points at these by ROLE, so an
# agent resolves the real path from here rather than being told one project's layout.
# OMIT ANY YOUR PROJECT LACKS — "it does not exist here" is a better answer than a
# path that never resolves.
# ---------------------------------------------------------------------------
paths:
  docs: docs
  index: docs/INDEX.md          # the router: feature, entity and decision indexes
  adrs: docs/decisions          # decision records
  proposed: docs/proposed       # staging for specs and designs, retired at epic close

  # OPTIONAL. Declare it and fold-in ② MOVES a spent epic folder here, dated and stamped,
  # instead of deleting it. Omit it and folders are deleted, which is the old behaviour.
  #
  # IT MUST SIT OUTSIDE `docs`, OUTSIDE `proposed`, AND OUTSIDE EVERY AREA. Four sweeps
  # glob those, and the sharpest is the decision register's contention pass: an archive
  # inside `proposed` would treat every retired proposal as a live contender and report
  # clashes forever. `make project` refuses a config that overlaps.
  #
  # Worth having for the CLOSE-OUT GATE more than for the files: "the staging folder is
  # empty" passes for an epic that folded nothing in, whereas "empty AND the archive entry
  # exists" does not.
  # archive: .spec-archive
  features: docs/features       # the source of truth for behaviour
  architecture: docs/architecture
  product: docs/product         # overview, NFRs, build sequence
  glossary: docs/product/glossary.md
  ia: docs/product/information-architecture.md   # constrains where a feature can live

# ---------------------------------------------------------------------------
# Domain vocabulary. The words that mean something in YOUR product and nothing in
# anyone else's — entities, states, the nouns your feature docs are full of.
#
# WHAT THIS IS FOR. It is not documentation; it is a guard. Prompts must not name your
# domain, because an agent that says "when a widget ships" is confidently wrong advice in
# a project that has no widgets. The harness ships with agents that are domain-free and a
# test that keeps them that way — this list is what that test checks against, so it only
# works if you fill it in.
#
# The placeholders below are examples, not a starting set: an unedited list guards nothing.
# ---------------------------------------------------------------------------
# ONLY UNAMBIGUOUS WORDS. A noun that also means something in software generally will
# fire on ordinary prose — one such word cost 41 false hits here before it was removed,
# because it named a product entity in one domain and a test construct in every codebase.
# Pick the words that mean nothing outside your product.
domain:
  nouns:
    - widget          # replace with yours: the entities your product is about
    - sprocket

# ---------------------------------------------------------------------------
# Lanes: which technology applies, which agent runs there, and how many at once.
#
# The cap is a MEASURED property of your machine and stack — how much memory one test
# process holds, whether an expensive build lives in this lane — so it belongs here
# rather than in a prompt that cannot know your hardware. The global concurrency
# ceiling is the real limit; lane caps decide the MIX beneath it.
# ---------------------------------------------------------------------------
lanes:
  backend:
    stacks: [python-uv]
    frameworks: [django]
    agent: fullstack-engineer
    cap: 6
    constraint: "test processes, ~500MB RSS each; RAM is the limit, not the database"
  frontend:
    stacks: [node-npm]
    frameworks: [nextjs]
    agent: fullstack-engineer
    cap: 4
    constraint: "typecheck + unit tests; the production build is not in this lane"
  test:
    stacks: [python-uv]
    frameworks: [django]
    agent: quality-engineer
    cap: 6
  e2e:
    stacks: [python-uv, node-npm]
    frameworks: [django, nextjs]
    agent: fullstack-engineer
    cap: 1
    constraint: "owns the end-to-end ports exclusively"
  docs:
    cap: 3
  # A lane that does design work opts into the fidelity axis. Without this, no worker
  # is given fidelity rules — which is correct for a project with no handover.
  # fidelity:
  #   agent: fidelity-auditor
  #   cap: 2
  #   fidelity: true
  infra:
    agent: fullstack-engineer
    cap: 4

# ---------------------------------------------------------------------------
# The area map. Two consumers, which is why it lives in one place: the lens brief
# groups changed paths by it, and `triggers` decides which lens a change must fire.
# Order is report order; a path matching nothing lands in `other` and is never lost.
# ---------------------------------------------------------------------------
areas:
  - path: src/api
    label: API surface
    triggers: [security]
  - path: src/services
    label: shared services
    triggers: [security]
  - path: src
    label: application code
  - path: tests
    label: tests
  - path: web
    label: web client
  - path: docs
    label: docs and decision records

# ---------------------------------------------------------------------------
# THE MOST PROJECT-SPECIFIC THING HERE. `verifier-security` answers "what can the
# wrong person now reach", which nobody can infer from code. A missing invariant is
# not a warning — it is a lens that never fires.
#
# REPLACE ALL OF THIS. The entries below are an example's rules, not yours.
# ---------------------------------------------------------------------------
security:
  paths:                        # a diff touching these always fires the security lens
    - src/api/
    - src/services/
  tokens:                       # identifiers that signal sensitive data
    # Yours, not these. Same warning as `invariants` below: a list borrowed from another
    # product keeps its shape — the fields it happens to store are a description of that
    # product, and `date_of_birth` in a tool that has no reason to hold one is a tell.
    - customer_account
    - bank_details
    - tax_id
    - is_approver
    - session
    - password
    - token
  invariants:                   # rules your project states and nothing enforces
    # Write YOUR rules here. These are deliberately from an unrelated domain — an
    # invoicing tool — so that copying them wholesale is obviously wrong rather than
    # subtly wrong. A set borrowed from another product keeps that product's shape even
    # when every individual word has been changed.
    - A credit note may never exceed the invoice it offsets.
    - Supplier bank details change only through the verified-change flow, never a PATCH.
    - A closed billing period is immutable; corrections open an adjustment period.

# ---------------------------------------------------------------------------
# Testing. Where tests live and what the project holds itself to. `test-doctrine`
# points at this rather than restating one project's layout.
# ---------------------------------------------------------------------------
testing:
  layout:
    "Service (unit and integration)":
      - "Co-located per module: `src/<module>/tests/`"
      - "Cross-module logic: `tests/integration/`"
    "Web client":
      - "Component tests beside the component"
      - "End-to-end covering the primary user journey only"
  gates:
    # A gate is a suite whose failure blocks the merge, named so a worker knows it is
    # not optional. Yours will be specific to you — this one is from the invoicing
    # example used throughout this file, and describes nothing real.
    - "`tests/ledger/test_reconciliation.py` — every posting rule against the recorded month-end set. A **CI gate**."
  coverage:
    - "**>=80% line coverage** on the critical paths named above."
  # The orchestrator runs these at the wave gate. WHATEVER RUNNER YOU NAME HERE must
  # also be granted in the orchestrator commands' `allowed-tools` — they ship granting
  # `Bash(make:*)`, so a project using `npm run ci` or `just check` must add its own.
  # A command matching no permission rule stops on a prompt that, in a background
  # dispatch, surfaces in the orchestrator's session where nobody is watching.
  aggregate_commands:
    "Whole repo": "`make test` - `make lint` - `make typecheck`"
    "End-to-end": "`make e2e` (owns its ports — serial, orchestrator only)"

# ---------------------------------------------------------------------------
# Structural roles. Agents must never name a directory: `src/api` is one project's
# spelling of "the API surface". They ask for the ROLE; you supply the path. Omit any
# role your project does not have — that is a real answer, not a gap.
# ---------------------------------------------------------------------------
layout:
  roles:
    api: src/api
    services: src/services
    ui: web

# ---------------------------------------------------------------------------
# Design fidelity. OMIT THIS BLOCK ENTIRELY if your project has no design handover —
# the fidelity tooling then stays dormant and workers are not given a command they
# cannot run.
#
# This was the one axis configured purely by environment variables, so a consuming
# project had no documented way to turn it on. Secrets are the exception and stay in
# the environment: `FIDELITY_USER` and `FIDELITY_PASS` have no default and no home in
# this file.
#
# A fidelity-using project must also provide `playwright` and `sharp` in its Node
# dependencies — the harness installs nothing and borrows them.
# ---------------------------------------------------------------------------
# fidelity:
#   handover_dir: ~/design-handover        # the package to compare against
#   app_url: http://localhost:3000
#   handover_url: http://localhost:8899/inspect.html
#   handover_selector: body
#   login_path: /login                     # omit for a no-auth app
#   user_label: Username or email
#   pass_label: Password
#   submit: sign in
#   node_modules: web/node_modules         # defaults to the node stack's dependency_dir
#   doctrine_skill: design-fidelity         # loaded on demand, never preloaded
#   card: |
#     Design fidelity:
#     - Read the handover SOURCE for the component AND its parent, never a screenshot.
#     - Compare side by side at both breakpoints; never from memory.
#     - Check every data state with the longest real names, not a flattering mock.
#     - Evidence or it is not done: the source excerpt AND the re-run composite.

# ---------------------------------------------------------------------------
# Verification. The four shipped lenses always apply; `additional` names project
# agents to dispatch alongside them — the extension point for a lens only this
# repository needs. They obey the same rule: any FAIL blocks the task.
# ---------------------------------------------------------------------------
lenses:
  additional: []

# ---------------------------------------------------------------------------
# Health signals. Baselines are MEASUREMENTS of this repository, so a value that
# means "healthy" here means nothing elsewhere. Recompute, never copy.
# ---------------------------------------------------------------------------
signals:
  baselines:
    # git log --oneline -200 | grep -ciE '^[0-9a-f]+ (fix|revert)'
    escape_rate: null
    first_pass_ceiling: 0.90
    first_pass_floor: 0.40
  megafile_lines: 1000

# Grants an operator has approved, in answer to a `Permission:` record in the decision
# queue. OPTIONAL — omit the block entirely and agents run on the derived grants alone.
#
# THIS IS THE ONLY WAY THE ALLOWLIST GROWS. An agent refused a tool it cannot work around
# files a request carrying the raw command; you answer it here, and the grant applies to
# the NEXT dispatch. No agent can write this key — `check_commands` refuses every
# normative section, so an agent cannot approve its own request.
#
# Grant the NARROWEST rule that unblocks the work. `Bash(curl https://pypi.org/*)` rather
# than `Bash(curl:*)`. A list that only ever widens has stopped being a control.
#
# A grant here can never defeat a deny rule: deny beats allow, so approving
# `Bash(git push:*)` still leaves pushing refused.
#
# permissions:
#   allow:
#     - Bash(curl https://pypi.org/*)   # answered PROJ-4f2a, narrowed from Bash(curl:*)
