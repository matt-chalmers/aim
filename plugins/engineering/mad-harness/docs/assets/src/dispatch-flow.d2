direction: down

start: { label: "dispatch(agent, prompt)"; shape: oval }
sandbox: { label: "require_sandbox()"; shape: diamond }
fail_sb: { label: "SandboxUnavailable"; style: { fill: "#fef2f2"; stroke: "#dc2626" } }

resolve: {
  label: "resolve(agent) — pure"
  tiers: "tiers.yaml\nprovider · model · effort · budget"
  fm: "agent frontmatter\ntier · tools · isolation"
  cfg: "harness.yaml\ntoolchain + operator grants"
  sb: "sandbox_for() + cache_paths()"
}

resolved: { label: "Resolved"; style: { fill: "#eef2ff"; stroke: "#4f46e5" } }
env_check: { label: "missing_env?"; shape: diamond }
fail_env: { label: "DispatchError\nempty credential reads as a 401"; style: { fill: "#fef2f2"; stroke: "#dc2626" } }
iso: { label: "isolation: worktree?"; shape: diamond }
wt: { label: "prepare_worktree()\n.claude/worktrees/harness-wN-<task>" }
ctx: { label: "with_context()\ncard · where you are · scripts · answered requests" }
envb: { label: "build_env()\ninherited + provider + caches" }
sdk: { label: "Agent SDK query()"; style: { fill: "#eef2ff"; stroke: "#4f46e5" } }
broker: { label: "broker — denial path ONLY\nexplain · record · file request" }
outcome: { label: "Outcome" }
telemetry: { label: "record() → Telemetry port"; shape: cylinder }

start -> sandbox
sandbox -> fail_sb: "unavailable"
sandbox -> resolve: "ok"
resolve -> resolved
resolved -> env_check
env_check -> fail_env: "yes"
env_check -> iso: "no"
iso -> wt: "yes"
iso -> ctx: "no"
wt -> ctx
ctx -> envb -> sdk
sdk -> broker: "tool refused" { style.stroke-dash: 3 }
broker -> sdk: "deny + remedy" { style.stroke-dash: 3 }
sdk -> outcome -> telemetry
