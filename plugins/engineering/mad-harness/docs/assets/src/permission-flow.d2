direction: down

cmd: { label: "agent issues a Bash command"; shape: oval }
sb: { label: "can it be sandboxed?"; shape: diamond }
auto: { label: "auto-approved\nautoAllowBashIfSandboxed"; style: { fill: "#eef2ff"; stroke: "#4f46e5" } }
os: { label: "OS boundary\nfilesystem + network"; shape: diamond }
runs: { label: "runs"; shape: oval }
eperm: { label: "fails at the syscall\nnot a permission denial"; style: { fill: "#fef2f2"; stroke: "#dc2626" } }

rules: { label: "permission rules\n(headless: no approver)"; shape: diamond }
deny: { label: "refused — deny beats allow"; style: { fill: "#fef2f2"; stroke: "#dc2626" } }
broker: { label: "broker" }
known: { label: "known cause?"; shape: diamond }
remedy: { label: "deny + remedy\ncompound · inline VAR= · source · variable path" }
file: { label: "deny + file Permission: record\ndep_add(task, request) blocks the task"; style: { fill: "#eef2ff"; stroke: "#4f46e5" } }

cmd -> sb
sb -> auto: "yes"
auto -> os
os -> runs: "within policy"
os -> eperm: "outside policy"
sb -> rules: "no — network to a\nnon-allowed host, or\nnot analysable"
rules -> deny: "matches deny"
rules -> runs: "matches allow"
rules -> broker: "no match"
broker -> known
known -> remedy: "yes"
known -> file: "no"
