direction: right

commit: { label: "commit + task\nbrief.sh <task> <sha>"; shape: oval }

brief: "brief" {
  style.stroke-dash: 4
  body: { label: "brief.md\ntask · criteria · files · worker notes"; style: { fill: "#eef2ff"; stroke: "#4f46e5" } }
  diff: { label: "diff/\nper-file patches · full.patch"; style: { fill: "#eef2ff"; stroke: "#4f46e5" } }
}

repo: { label: "repository at HEAD"; shape: cylinder }

l1: "L1 verifier\ncorrectness"
l2: "L2 verifier-tests\nwould a regression be caught"
l3: { label: "L3 verifier-spec\ndocs · callers · blast radius"; style: { fill: "#fef2f2"; stroke: "#dc2626" } }
l4: "L4 verifier-security\nfires on an areas trigger"

commit -> brief.body
commit -> brief.diff

brief.body -> l1
brief.body -> l2
brief.body -> l3
brief.body -> l4
brief.diff -> l1
brief.diff -> l2
brief.diff -> l4
brief.diff -> l3: "NEVER" { style: { stroke: "#dc2626"; stroke-dash: 4 } }
repo -> l3
