direction: right

activity: {
  label: "ACTIVITY — what the work IS"
  style: { fill: "#eef2ff"; stroke: "#4f46e5" }
  id: "verify.spec · design.create · work.implement"
  agent: "agent: who performs it\n(checked, never derived)"
  fields: "strengths · max_budget_usd · task_budget_tokens\nat activity level, per complexity bucket, or both"
  id -> agent
  id -> fields
}

cx: { label: "complexity\nsimple | standard | complex"; shape: hexagon; style.fill: "#fffbeb" }

resolve: {
  label: "specificity wins, FIELD BY FIELD"
  shape: diamond
  style: { fill: "#f0fdf4"; stroke: "#16a34a" }
}

refuse: {
  label: "no `strengths` anywhere\n→ REFUSED"
  style: { fill: "#fef2f2"; stroke: "#dc2626" }
}

chain: {
  label: "the chain: [mid, strong, elite]"
  head: "head RUNS"
  rest: "the rest are where\nESCALATE goes"
  head -> rest: "ADEQUACY/VERDICT: ESCALATE" { style.stroke-dash: 3 }
}

strength: {
  label: "STRENGTH — what RUNS it"
  style: { fill: "#eef2ff"; stroke: "#4f46e5" }
  f: "provider · model · thinking\nand nothing else"
}

explicit: { label: "--strength\n(rank 1: operator, or an escalation step)"; shape: oval }

activity -> resolve
cx -> resolve
resolve -> chain: "resolved"
resolve -> refuse: "nothing to resolve"
chain -> strength
explicit -> strength: "overrides rank 2"

note: |md
  High risk is not a rank: it reads the surface as
  **complex**, so the activity's own bucket decides.
  A project PATCHES these blocks — provenance, not precedence.
| { near: bottom-center }
